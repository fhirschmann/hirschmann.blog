---
import type { Project } from '../data/projects';

interface Props {
  projects: Project[];
  compact?: boolean;
  class?: string;
  style?: string;
}

const { projects, compact = false, class: className, style } = Astro.props;
---

<ul class:list={['rows', { 'rows-compact': compact }, className]} style={style}>
  {
    projects.map((p) => (
      <li class:list={{ 'project-entry': p.image }}>
        {p.image && (
          <a
            class="project-preview"
            href={p.href}
            target="_blank"
            rel="noopener"
            aria-label={`Open ${p.name} project (opens in a new tab)`}
          >
            <span class="project-image">
              <img
                src={p.image.src}
                srcset={p.image.srcset}
                sizes={compact ? '(max-width: 680px) 224px, 192px' : '(max-width: 680px) 90vw, 248px'}
                alt={p.image.alt}
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
              />
            </span>
          </a>
        )}
        <div class="project-info">
          <a class="row" href={p.href} target="_blank" rel="noopener">
            <span class="row-title">{p.name}</span>
            <span class="row-meta">
              {p.meta}
              {p.status && <span class="stale"> [{p.status}]</span>}
            </span>
            <span class="row-arrow">[↗]</span>
          </a>
          <p class="row-desc">{p.desc}</p>
        </div>
      </li>
    ))
  }
</ul>
