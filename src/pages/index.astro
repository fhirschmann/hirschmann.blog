---
import Base from '../layouts/Base.astro';
import ProjectRows from '../components/ProjectRows.astro';
import { projects, archived } from '../data/projects';
---

<Base
  title="Fabian Hirschmann"
  description="Personal homepage of Fabian Hirschmann — open-source and hobby projects."
>
  <main class="wrap">
    <section class="hero">
      <h1 class="sr-only">Fabian Hirschmann</h1>
      <figure class="portrait reveal" style="--d:.5s">
        <img src="/me-2026-pixel.webp" alt="Pixelated portrait of Fabian Hirschmann" width="64" height="65" />
      </figure>

      <p class="intro reveal" style="--d:.4s">
        hobbyist · open-source tinkerer
      </p>
    </section>

    <section id="projects" class="section reveal" style="--d:.55s">
      <div class="section-head">
        <span class="index"></span>
        <h2>Projects</h2>
      </div>
      <ProjectRows projects={projects} compact />
      <p class="section-more">
        # + {archived.length} archived projects in <a href="/projects#archived">./projects/.archive</a>
      </p>
    </section>

    <section id="contact" class="section reveal" style="--d:.65s">
      <div class="section-head">
        <span class="index"></span>
        <h2>Contact</h2>
      </div>
      <ul class="rows">
        <li>
          <a class="row" href="https://github.com/fhirschmann" target="_blank" rel="noopener">
            <span class="row-title">github</span>
            <span class="row-meta">github.com/fhirschmann</span>
            <span class="row-arrow">[↗]</span>
          </a>
        </li>
        <li>
          <a class="row" id="email-row">
            <span class="row-title">email</span>
            <span class="row-meta" id="email-meta">[ encrypted — javascript required ]</span>
            <span class="row-arrow">[↗]</span>
          </a>
        </li>
      </ul>
    </section>
  </main>

  <script>
    // Assemble the address at runtime from char codes so neither the address
    // nor readable fragments of it end up in the served HTML/JS (a plain
    // String.fromCharCode(64) would get constant-folded to "@" by the bundler).
    const codes = [102, 97, 98, 105, 97, 110, 64, 104, 105, 114, 115, 99, 104, 109, 97, 110, 110, 46, 101, 109, 97, 105, 108];
    const addr = codes.map((c) => String.fromCharCode(c)).join('');
    const row = document.getElementById('email-row') as HTMLAnchorElement;
    const meta = document.getElementById('email-meta')!;
    row.href = 'mailto:' + addr;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      meta.textContent = addr;
    } else {
      const glyphs = '01#$%&?!<>[]{}=*';
      let frame = 0;
      const frames = 16;
      const tick = () => {
        frame++;
        const solved = Math.floor((frame / frames) * addr.length);
        meta.textContent =
          addr.slice(0, solved) +
          Array.from({ length: addr.length - solved }, () => glyphs[(Math.random() * glyphs.length) | 0]).join('');
        if (solved < addr.length) setTimeout(tick, 40);
      };
      tick();
    }
  </script>
</Base>
