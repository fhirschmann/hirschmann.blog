---
import Base from '../layouts/Base.astro';
import ProjectRows from '../components/ProjectRows.astro';
import { projects, archived } from '../data/projects';
---

<Base
  title="Projects — Fabian Hirschmann"
  description="Personal open-source and hobby projects by Fabian Hirschmann."
>
  <main class="wrap">
    <h1 class="page-title reveal" style="--d:.1s;">Projects</h1>
    <p class="section-note reveal" style="--d:.15s"># personal open-source &amp; hobby projects — built for fun, provided as-is</p>

    <ProjectRows
      projects={projects}
      class="reveal"
      style="--d:.2s; margin-bottom: clamp(2.2rem, 6vh, 3.8rem);"
    />

    <section id="archived" class="section reveal" style="--d:.3s; padding-bottom: clamp(2.5rem, 7vh, 4.5rem);">
      <div class="section-head">
        <span class="index"></span>
        <h2>Archived</h2>
      </div>
      <p class="section-note"># no longer maintained — kept around for reference</p>
      <ProjectRows projects={archived} />
    </section>
  </main>
</Base>
